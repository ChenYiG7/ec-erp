<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.own.erp</groupId>
        <artifactId>ec-erp</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>erp-finance</artifactId>
    <description>财务中心:收付款、成本核算、利润报表、平台结算报告解析(亚马逊Settlement等)、多币种/汇率、头程运费分摊</description>

    <dependencies>
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-common</artifactId>
        </dependency>
        <!-- 仅消费 UnifiedSettlement 落库模型(#19 saveUnifiedSettlement),禁调平台 API;
             同 erp-order 消费 UnifiedOrder 规约(docs/07 §2.2) -->
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-platform-sdk</artifactId>
        </dependency>
        <!-- 契约模型(ProfitQueryApi 契约消费 + Controller 出参复用契约 record,#19③) -->
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-contract</artifactId>
        </dependency>
        <!-- 本模块含 Controller/CRUD,自带 web + mybatis-plus;由 erp-api 聚合运行 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 仅 @PreAuthorize 注解(汇率写侧 admin 鉴权),过滤链仍收口 erp-api(禁引 Security starter),同 erp-purchase 先例 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- 参数校验(@Valid),TODO#7 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
