<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.own.erp</groupId>
        <artifactId>ec-erp</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>erp-shop</artifactId>
    <description>平台中心:店铺管理、OAuth授权中心(Token加密存储/统一刷新)、多商户(总部-商户-店铺)、平台拉取日志、平台开关</description>

    <dependencies>
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-common</artifactId>
        </dependency>
        <!-- 跨域契约接口(#5 bind sku_id 存在性校验):只依赖接口,实现收口 erp-api(docs/07 §2.2) -->
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.own.erp</groupId>
            <artifactId>erp-platform-sdk</artifactId>
        </dependency>
        <!-- 本模块含 Controller/CRUD,自带 web + mybatis-plus;由 erp-api 聚合运行 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验(@Valid),TODO#7 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- SKU映射人工绑定接口 @PreAuthorize 鉴权:只引 core(注解),不引 security starter(过滤链归 erp-api) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
