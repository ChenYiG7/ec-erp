# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 接口基础地址:留空 = 同源,走 vite proxy(见 .env.development VITE_PROXY)
# api 函数路径一律写后端全路径(以 /api 开头),代理不做 rewrite
VITE_API_URL = 

# 开发环境跨域代理:/api -> 本地后端 8088(禁 rewrite,后端真实路径含 /api)
VITE_PROXY = [["/api","http://localhost:8088"]]
